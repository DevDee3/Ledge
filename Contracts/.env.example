# Copy to .env and fill in. .env is git-ignored. Never commit a real key.
# Base mainnet (chain id 8453) and Base Sepolia (chain id 84532).
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# A Base-compatible oracle adapter deployed before LedgeRegistry.
LEDGE_ORACLE=0x...
# For DeployBaseTestnet.s.sol only: wallet that is allowed to publish testnet prices.
ORACLE_OWNER=0x...
# Wallet allowed to resolve markets and update their reference prices.
MARKET_OWNER=0x...

# Preferred: import your key into a Foundry keystore instead (cast wallet import deployer --interactive)
# and deploy with --account deployer. Only set this if you must use a raw key.
# PRIVATE_KEY=0x...
