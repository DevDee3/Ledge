# Copy to .env.local. Nothing here is required to run the hedge calculator.
# NEXT_PUBLIC_* values are baked in at BUILD time: change one, then rebuild (npm run build).

# ---- On-chain record (the link to LedgeRegistry). Leave unset to hide the panel's actions. ----
# 8453 = Base mainnet, 84532 = Base Sepolia, 31337 = local Anvil.
# Use Base Sepolia while developing. Production deployments should set this explicitly.
NEXT_PUBLIC_CHAIN_ID=84532
# Address printed by the Base deployment script.
NEXT_PUBLIC_LEDGE_REGISTRY=
# Address of the oracle adapter deployed for the same Base network.
NEXT_PUBLIC_LEDGE_ORACLE=
NEXT_PUBLIC_MARKET_FACTORY=
NEXT_PUBLIC_LEDGE_COLLATERAL=
# Block the registry was deployed at, as a decimal number. Keeps the event scan small.
NEXT_PUBLIC_LEDGE_DEPLOY_BLOCK=
# Optional: your own RPC for that chain. Defaults to Base's public RPC.
# NEXT_PUBLIC_EVM_RPC=https://sepolia.base.org
# This template targets the Base Sepolia-native Ledge market protocol.
NEXT_PUBLIC_ENABLE_TRADING=0
# Set to 1 only after NEXT_PUBLIC_LEDGE_REGISTRY and NEXT_PUBLIC_LEDGE_DEPLOY_BLOCK are populated and verified.
# Base Sepolia explorer (replace only if your deployment uses another explorer).
NEXT_PUBLIC_EXPLORER_URL=https://sepolia.basescan.org/tx

# ---- Server side, both optional ----
# Base market discovery and collateral contracts, printed by DeployBaseMarket.s.sol.
# Production should always disable invented market data.
LEDGE_DISABLE_DEMO=1
